<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Only the permissions the ONDE mesh app actually uses.
         Removed (unused by code): BLUETOOTH, BLUETOOTH_ADMIN,
         RECORD_AUDIO, ACCESS_FINE/COARSE_LOCATION,
         WRITE/READ_EXTERNAL_STORAGE. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:icon="@drawable/ic_launcher_foreground"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.ONDE"
        android:usesCleartextTraffic="false">

        <!-- exported="true" est REQUIS pour l'activité lanceur
             (intent-filter MAIN/LAUNCHER). Aucune autre activité/service
             n'est exporté. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>